generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model EquipmentType {
  id                     String     @id @default(uuid())
  name                   String     @unique
  maintenanceIntervalHours Int       @map("maintenance_interval_hours")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  equipment              Equipment[]

  @@map("equipment_types")
}

model Equipment {
  id                      String     @id @default(uuid())
  code                    String     @unique
  equipmentTypeId         String     @map("equipment_type_id")
  equipmentType           EquipmentType @relation(fields: [equipmentTypeId], references: [id])
  horometer               Int        @default(0)
  lastMaintenanceHorometer Int       @default(0) @map("last_maintenance_horometer")
  appliedIntervalHours    Int        @map("applied_interval_hours")
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @updatedAt @map("updated_at")

  maintenance             Maintenance[]

  @@index([equipmentTypeId])
  @@index([code])
  @@map("equipment")
}

model Maintenance {
  id                      String     @id @default(uuid())
  equipmentId             String     @map("equipment_id")
  equipment               Equipment  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  horometerAtMaintenance  Int        @map("horometer_at_maintenance")
  description             String?
  performedAt             DateTime   @default(now()) @map("performed_at")

  @@index([equipmentId])
  @@index([performedAt])
  @@map("maintenance")
}